# muse-proxy-go 环境变量样例（复制为 .env 后按部署环境填写实值；.env 不入库）
# 真实 key 只写进部署环境的 EnvironmentFile，绝不提交、绝不打印。

# 监听地址。只允许回环地址，非回环会在启动时被拒绝。
MUSE_LISTEN=127.0.0.1:19287

# 上游 base（自带 /v1；代理会去掉请求路径的前导 /v1 再拼接，避免重复）。
MUSE_UPSTREAM=https://example.invalid/zen/go/v1

# 强制出口代理（mixed 端口）。必填且必须可达，本服务不直连上游。
MIXED_PROXY=http://127.0.0.1:7890

# 上游真实 key。优先级最高；留空则回退到下面的配置文件来源。
MUSE_UPSTREAM_KEY=

# 回退来源 1：pi 的 models.json，取 providers["opencode-go"]["apiKey"]（以 ! 开头视为占位无效）。
PI_MODELS_JSON=/root/.pi/agent/models.json

# 回退来源 2：opencode 的 auth.json，取 ["opencode-go"]["key"]。
OPENCODE_AUTH_JSON=/root/.local/share/opencode/auth.json

# 上游超时（Go duration，默认 120s）。仅用于连接/握手/响应头阶段。
MUSE_TIMEOUT=120s

# 真流式透传开关：1 打开（chunked、无 Content-Length、边收边发），其它值/留空为整段缓冲（旧实现语义）。
MUSE_STREAM=0
